# LLM Configuration (Ollama)
LLM_MODEL=deepseek-r1:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# RAG Settings
RAG_TOP_K=3

# Optional: LlamaParse API Key (for PDF ingestion)
# LLAMA_CLOUD_API_KEY=your_key_here
